/* wofi - Catppuccin Mocha */

* {
    font-family: "JetBrainsMono Nerd Font", "Inter", sans-serif;
    font-size: 14px;
    border: none;
    box-shadow: none;
}

window {
    background-color: ${BG_BASE_HEX};
    border: 2px solid ${ACCENT_PRIMARY};
    border-radius: 12px;
}

#outer-box {
    padding: 10px;
}

#input {
    margin: 0 0 10px 0;
    padding: 8px 12px;
    background-color: ${BG_SURFACE0_HEX};
    color: ${FG_TEXT_HEX};
    border-radius: 8px;
    border: 1px solid ${BG_SURFACE1_HEX};
    caret-color: ${ACCENT_PRIMARY};
}

#input:focus {
    border-color: ${ACCENT_PRIMARY};
    outline: none;
}

#inner-box {
    margin: 0;
}

#scroll {
    margin: 0;
}

#text {
    color: ${FG_TEXT_HEX};
    padding: 2px 8px;
}

#entry {
    padding: 6px 8px;
    border-radius: 6px;
}

#entry:selected {
    background-color: ${ACCENT_PRIMARY};
}

#entry:selected #text {
    color: ${BG_BASE_HEX};
}

#entry:hover {
    background-color: ${BG_SURFACE0_HEX};
}
