#!/usr/bin/env bash
#
# theme — one-command theme switcher for Hyprland.
# Renders templates with envsubst and reloads the relevant daemons.
#
set -euo pipefail

# ------------------------------------------------------------
#  Paths
# ------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
TEMPLATES_DIR="$REPO_DIR/templates"
THEMES_DIR="$REPO_DIR/themes"
USER_CONFIG_DIR="$HOME/.config/hypr-themes"
ACTIVE_LINK="$USER_CONFIG_DIR/.active"
WALLPAPERS_CONF="$USER_CONFIG_DIR/wallpapers.conf"

# ------------------------------------------------------------
#  User config (WALLPAPER_DIR, DEFAULT_THEME, *_CONFIG_DIR)
# ------------------------------------------------------------
if [[ -f "$USER_CONFIG_DIR/config.sh" ]]; then
    # shellcheck source=/dev/null
    source "$USER_CONFIG_DIR/config.sh"
fi

: "${WALLPAPER_DIR:=$HOME/Pictures/Wallpapers}"
: "${DEFAULT_THEME:=peach}"
: "${HYPR_CONFIG_DIR:=$HOME/.config/hypr}"
: "${WOFI_CONFIG_DIR:=$HOME/.config/wofi}"
: "${DUNST_CONFIG_DIR:=$HOME/.config/dunst}"

# WALLPAPER_DIR is consumed by the hyprpaper template, so envsubst (which reads
# the environment) needs it exported.
export WALLPAPER_DIR

# Explicit allowlist for envsubst. Only these expand; anything else in a
# template (e.g. hyprlock's $FAIL / $ATTEMPTS) is left untouched.
THEME_VARS='$ACCENT_PRIMARY $ACCENT_RGB $BORDER_COLOR_1 $BORDER_COLOR_2 $BORDER_ANGLE $GLOW_COLOR $BG_BASE_HEX $BG_BASE_RGB $BG_MANTLE_RGB $BG_SURFACE0_HEX $BG_SURFACE1_HEX $FG_TEXT_HEX $FG_TEXT_RGB $FG_SUBTEXT0_HEX $COLOR_RED_HEX $COLOR_RED_RGB $COLOR_OVERLAY_HEX $WALLPAPER $WALLPAPER_DIR'

# ------------------------------------------------------------
#  Helpers
# ------------------------------------------------------------

# True only on a real interactive terminal — gates every prompt so install
# scripts, keybinds and pipes keep the non-interactive behaviour.
is_tty() { [[ -t 0 && -t 1 ]]; }

# Map a template's tool dir (first path component) to its destination dir.
target_for() {
    local rel="$1" tool="${1%%/*}" sub="${1#*/}"
    case "$tool" in
        hypr)  echo "$HYPR_CONFIG_DIR/$sub" ;;
        wofi)  echo "$WOFI_CONFIG_DIR/$sub" ;;
        dunst) echo "$DUNST_CONFIG_DIR/$sub" ;;
        *)     echo "$HOME/.config/$rel" ;;
    esac
}

cmd_list() {
    local f
    for f in "$THEMES_DIR"/*.theme; do
        [[ -e "$f" ]] || continue
        basename "$f" .theme
    done
}

cmd_current() {
    if [[ -L "$ACTIVE_LINK" ]]; then
        basename "$(readlink -f "$ACTIVE_LINK")" .theme
    else
        echo "none"
    fi
}

# Image files at the top level of WALLPAPER_DIR, one per line.
list_wallpapers() {
    find "$WALLPAPER_DIR" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        -printf '%f\n' 2>/dev/null | sort
}

# Per-user wallpaper override for a theme (empty if none). Always exits 0.
wallpaper_override() {
    local name="$1" line
    [[ -f "$WALLPAPERS_CONF" ]] || return 0
    line="$(grep -m1 "^${name}=" "$WALLPAPERS_CONF" 2>/dev/null || true)"
    [[ -n "$line" ]] && printf '%s\n' "${line#*=}"
    return 0
}

# Persist a per-user wallpaper choice (override file, never the repo theme).
save_wallpaper_override() {
    local name="$1" file="$2" tmp
    mkdir -p "$USER_CONFIG_DIR"
    if [[ -f "$WALLPAPERS_CONF" ]]; then
        tmp="$(mktemp)"
        grep -v "^${name}=" "$WALLPAPERS_CONF" > "$tmp" 2>/dev/null || true
        mv "$tmp" "$WALLPAPERS_CONF"
    fi
    printf '%s=%s\n' "$name" "$file" >> "$WALLPAPERS_CONF"
}

# Interactive picker. Prompts/menus go to stderr; the chosen filename (if any)
# is the only thing printed to stdout, so it can be captured with $(...).
prompt_wallpaper() {
    local name="$1" desc="$2" ans="" choice="" i
    {
        echo
        echo "Theme '$name'${desc:+ — $desc}"
        echo "No wallpaper found for this theme in $WALLPAPER_DIR."
    } >&2
    read -rp "Associate a wallpaper now? [Y/n] " ans || true
    case "${ans,,}" in n|no) return 0 ;; esac

    local imgs=()
    mapfile -t imgs < <(list_wallpapers)
    if (( ${#imgs[@]} == 0 )); then
        echo "No image files in $WALLPAPER_DIR — skipping (check WALLPAPER_DIR in config.sh)." >&2
        return 0
    fi

    {
        echo "Images in $WALLPAPER_DIR:"
        for i in "${!imgs[@]}"; do printf '  %2d) %s\n' "$((i + 1))" "${imgs[$i]}"; done
    } >&2
    read -rp "Choose a number, type a filename, or Enter to skip: " choice || true
    [[ -z "$choice" ]] && return 0
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#imgs[@]} )); then
        printf '%s\n' "${imgs[$((choice - 1))]}"
    elif [[ -f "$WALLPAPER_DIR/$choice" ]]; then
        printf '%s\n' "$choice"
    else
        echo "Not found: $choice — skipping." >&2
    fi
    return 0
}

reload_daemons() {
    hyprctl reload >/dev/null 2>&1 || true
    if pkill -x dunst >/dev/null 2>&1; then
        (sleep 0.5; setsid dunst >/dev/null 2>&1 &)
    fi
    if pkill -9 -x hyprpaper >/dev/null 2>&1; then
        (sleep 0.5; setsid hyprpaper >/dev/null 2>&1 &)
    fi
}

cmd_apply() {
    local theme="$1"
    local theme_file="$THEMES_DIR/${theme}.theme"

    if [[ ! -f "$theme_file" ]]; then
        echo "Error: theme '$theme' not found." >&2
        echo "Available themes:" >&2
        cmd_list >&2
        exit 1
    fi

    # Export theme vars for envsubst.
    set -a
    # shellcheck source=/dev/null
    source "$theme_file"
    set +a

    # Resolve the wallpaper: per-user override beats the theme default.
    local wp="${WALLPAPER:-}" ov
    ov="$(wallpaper_override "$theme")"
    [[ -n "$ov" ]] && wp="$ov"

    # If it's missing, offer to pick one (interactive only); otherwise keep
    # the current wallpaper instead of writing a broken path.
    local render_wp=1
    if [[ -z "$wp" || ! -f "$WALLPAPER_DIR/$wp" ]]; then
        if is_tty; then
            wp="$(prompt_wallpaper "$theme" "${THEME_DESCRIPTION:-}")"
            if [[ -n "$wp" ]]; then
                save_wallpaper_override "$theme" "$wp"
            else
                render_wp=0
            fi
        else
            echo "Warning: wallpaper '${wp:-<none>}' not found in $WALLPAPER_DIR — keeping current wallpaper." >&2
            render_wp=0
        fi
    fi
    export WALLPAPER="$wp"

    local count=0 tmpl rel target
    while IFS= read -r tmpl; do
        rel="${tmpl#"$TEMPLATES_DIR"/}"   # hypr/modules/config.lua.tmpl
        rel="${rel%.tmpl}"                # hypr/modules/config.lua
        target="$(target_for "$rel")"

        # Skip the wallpaper config when there's no valid wallpaper to set.
        if [[ "$target" == *"/hyprpaper.conf" && $render_wp -eq 0 ]]; then
            continue
        fi

        mkdir -p "$(dirname "$target")"

        # Pristine backup, created once, restored by uninstall.sh.
        if [[ -f "$target" && ! -e "$target.orig" ]]; then
            cp "$target" "$target.orig"
        fi

        # Render to a temp file, then validate/move atomically.
        envsubst "$THEME_VARS" < "$tmpl" > "$target.tmp"

        if [[ "$target" == *.lua ]] && ! luac -p "$target.tmp" 2>/dev/null; then
            echo "Warning: generated $target is invalid Lua — keeping previous file." >&2
            rm -f "$target.tmp"
            continue
        fi

        mv "$target.tmp" "$target"
        count=$((count + 1))
    done < <(find "$TEMPLATES_DIR" -type f -name '*.tmpl' | sort)

    mkdir -p "$USER_CONFIG_DIR"
    ln -sfn "$theme_file" "$ACTIVE_LINK"

    reload_daemons

    echo "Theme: $theme ($count templates applied)"
}

# theme wallpaper [name] — (re)associate a wallpaper for a theme, then apply it.
cmd_wallpaper() {
    local theme="${1:-}"
    [[ -z "$theme" ]] && theme="$(cmd_current)"
    if [[ "$theme" == "none" || ! -f "$THEMES_DIR/${theme}.theme" ]]; then
        echo "Usage: theme wallpaper <name>   (no valid theme given)" >&2
        exit 1
    fi
    if ! is_tty; then
        echo "Error: 'theme wallpaper' needs an interactive terminal." >&2
        exit 1
    fi

    local THEME_DESCRIPTION=""
    # shellcheck source=/dev/null
    source "$THEMES_DIR/${theme}.theme"

    local wp
    wp="$(prompt_wallpaper "$theme" "${THEME_DESCRIPTION:-}")"
    if [[ -n "$wp" ]]; then
        save_wallpaper_override "$theme" "$wp"
        echo "Wallpaper for '$theme' set to: $wp"
        cmd_apply "$theme"
    else
        echo "No change."
    fi
}

cmd_interactive() {
    local chosen
    chosen="$(cmd_list | wofi --dmenu --prompt theme)" || exit 0
    [[ -n "$chosen" ]] && cmd_apply "$chosen"
}

cmd_help() {
    cat <<'EOF'
theme — one-command theme switcher for Hyprland

Usage:
  theme <name>          Apply the theme <name>
  theme                 Interactive picker (wofi)
  theme list            List available themes
  theme current         Show the active theme
  theme wallpaper [n]   Pick/change the wallpaper for a theme (default: active)
  theme --help          Show this help
EOF
}

# ------------------------------------------------------------
#  Routing
# ------------------------------------------------------------
case "${1:-}" in
    list)        cmd_list ;;
    current)     cmd_current ;;
    wallpaper)   cmd_wallpaper "${2:-}" ;;
    --help|-h)   cmd_help ;;
    "")          cmd_interactive ;;
    *)           cmd_apply "$1" ;;
esac
