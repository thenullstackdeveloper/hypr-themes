# ============================================================
#  dunst config
# ============================================================
# This file is YOURS — hypr-themes never overwrites it. Themed colors live in
# the drop-in dunstrc.d/99-hypr-themes.conf (regenerated by `theme <name>`),
# which dunst loads after this file and which overrides only the colors.
# Everything else here (geometry, fonts, behaviour) is yours to edit.

[global]
    # Geometry
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 200)
    origin = top-right
    offset = (20, 50)
    scale = 0
    notification_limit = 5

    # Progress bar (Spotify, downloads...)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    # Appearance
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 8
    frame_width = 2
    separator_color = frame
    corner_radius = 12

    # Typography
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sort = yes

    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    # History
    sticky_history = yes
    history_length = 20

    # Integrations
    dmenu = wofi --dmenu --prompt dunst
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    force_xwayland = false

    # Mouse
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
